# 필수: GitHub 사용자 이름
GITHUB_USERNAME=your_github_username

# 필수: GitHub Personal Access Token (classic)
# 필요한 scope: user:follow, read:user
# 발급: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token

# 선택: GitHub API URL (기본값 사용 권장)
GITHUB_API_URL=https://api.github.com

# 선택: 동시 요청 개수 (기본 5)
CONCURRENCY=5

# 선택: 팔로우/언팔로우에서 제외할 사용자 (쉼표 구분, 대소문자 무관)
# 예) 내가 좋아해서 계속 팔로우하고 싶은 유명 개발자 (그쪽에선 맞팔 안해줄 때): EXCLUDE_UNFOLLOW
# 예) 나를 팔로우했지만 맞팔하고 싶지 않은 스팸 계정: EXCLUDE_FOLLOW
EXCLUDE_FOLLOW=
EXCLUDE_UNFOLLOW=

# 선택: "1"/"true" 로 설정 시 실제 변경 없이 대상만 로그로 출력 (Lambda 전용, 로컬은 --dry-run 플래그 사용)
DRY_RUN=
